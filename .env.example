# ============================================================
# CDMS — Environment Variables
# ============================================================
# Copy file này thành .env và điền giá trị thực:
#   cp .env.example .env
#
# ⚠️  KHÔNG commit file .env vào git (đã có trong .gitignore)
# ============================================================

# ── PostgreSQL ──────────────────────────────────────────────
POSTGRES_DB=cdms
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5433

# ── Application ─────────────────────────────────────────────
APP_PORT=8080

# ── CDMS Polling ────────────────────────────────────────────
# Interval tính bằng milliseconds (60000 = 60 giây)
CDMS_POLLING_INTERVAL_MS=60000
CDMS_POLLING_ENABLED=true